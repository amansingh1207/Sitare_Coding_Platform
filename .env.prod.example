# ============================================================
# CodingJudge Production Environment Configuration
# Copy this file to .env.prod and fill in real values
# NEVER commit .env.prod to version control!
# ============================================================

# ---------- Database (Neon - Poolers works on Render) ----------
DB_HOST=ep-lingering-brook-b4azce0b-pooler.c-6.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password-here

# Alternative: Direct connection string (if pooler has issues)
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-lingering-brook-b4azce0b-pooler.c-6.us-east-2.aws.neon.tech:5432/neondb?sslmode=require&channel_binding=require

# ---------- JWT Authentication ----------
# Generate with: openssl rand -hex 32
JWT_SECRET=your-256-bit-random-string-here
JWT_EXPIRATION_MS=86400000

# ---------- Email (SendGrid API - Works on Render Free Tier) ----------
# Get API Key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
MAIL_FROM=codingjudgesitare@gmail.com
MAIL_FROM_NAME=CodingJudge

# ---------- Server ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ---------- Judge Configuration ----------
JUDGE_DOCKER_IMAGE=codingjudge/sandbox:latest
JUDGE_TIMEOUT_MS=10000
JUDGE_MEMORY_LIMIT_MB=256
JUDGE_CPU_LIMIT=1.0
JUDGE_MAX_OUTPUT_SIZE_KB=64
JUDGE_MAX_SOURCE_SIZE_KB=256

# ---------- Frontend ----------
VITE_API_BASE_URL=https://sitare-coding-platform.onrender.com/api

# ---------- Domain ----------
DOMAIN=sitare-coding-platform.onrender.com