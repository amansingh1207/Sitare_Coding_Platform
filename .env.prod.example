# ============================================================
# CodingJudge Production Environment Configuration
# Copy this file to .env.prod and fill in real values.
# NEVER commit .env.prod to version control.
# ============================================================

# ---------- Database ----------
DB_NAME=codingjudge
DB_USER=codingjudge
DB_PASSWORD=change_this_to_a_strong_random_password

# ---------- JWT Authentication ----------
JWT_SECRET=change_this_to_a_long_random_string_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# ---------- Judge Configuration ----------
JUDGE_DOCKER_IMAGE=codingjudge/sandbox:latest
JUDGE_TIMEOUT_MS=10000
JUDGE_MEMORY_LIMIT_MB=256
JUDGE_CPU_LIMIT=1.0
JUDGE_MAX_OUTPUT_SIZE_KB=64
JUDGE_MAX_SOURCE_SIZE_KB=256

# ---------- Email (Gmail SMTP) ----------
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_NAME=CodingJudge

# ---------- Domain & SSL ----------
# Replace with your actual domain
DOMAIN=codingjudge.yourdomain.com

# ---------- Server ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod