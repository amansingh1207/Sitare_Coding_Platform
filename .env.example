# ============================================================
# CodingJudge Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codingjudge
DB_USER=codingjudge
DB_PASSWORD=change_me_in_production

# ---------- JWT Authentication ----------
JWT_SECRET=change_this_to_a_long_random_string_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# ---------- Spring Boot ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- Judge / Docker ----------
JUDGE_DOCKER_IMAGE=codingjudge/sandbox:latest
JUDGE_TIMEOUT_MS=10000
JUDGE_MEMORY_LIMIT_MB=256
JUDGE_CPU_LIMIT=1.0
JUDGE_MAX_OUTPUT_SIZE_KB=64
JUDGE_MAX_SOURCE_SIZE_KB=256

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080/api

# ---------- Email (Gmail SMTP) ----------
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=CodingJudge

